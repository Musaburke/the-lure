---
import '../styles/global.css';

interface Props { title?: string; description?: string }
const {
  title = 'The Lure',
  description = 'Dive 4,000 metres. Meet the deep-sea animals that trick their prey, and the scams that copy them.',
} = Astro.props;
const fullTitle = title === 'The Lure' ? 'The Lure: deep-sea tricks and the scams that copy them' : `${title} · The Lure`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0d5274" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline src="/js-flag.js"></script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <slot />
  </body>
</html>

<style>
  .skip {
    position: absolute; left: var(--margin); top: -4rem; z-index: 50;
    background: var(--pill); color: var(--pill-ink);
    padding: 0.75rem 1.25rem; border-radius: 999px; text-decoration: none;
  }
  .skip:focus-visible { top: 1rem; }
</style>
